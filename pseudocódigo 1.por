PROGRAMA
{
    FUNCAO INICIO
    {
        REAL BASE, ALTURA, AREA

        ESCREVA("Digite a base (em metros): ")
        LEIA(BASE)
        ESCREVA("Digite a altura (em metros): ")
        LEIA(ALTURA)

        AREA <- BASE * ALTURA

        ESCREVA("A área do retângulo é: ", AREA, "m²")
    }
}

